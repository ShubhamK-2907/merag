# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://merag-.*\.vercel\.app

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Local MongoDB or a MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=merag

# LLM provider: "gemini" (free key from https://aistudio.google.com/apikey),
# "groq" (free key from https://console.groq.com/keys) or "openai" (paid)
LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
# Fallback models tried in order when the one before is rate-limited (each has its own free quota).
# Entries whose provider has no API key are skipped.
LLM_FALLBACKS=gemini:gemini-3.1-flash-lite,gemini:gemini-2.5-flash-lite,groq:openai/gpt-oss-20b
# One extra LLM call per document answer that checks it against its sources; false saves quota.
VERIFY_ANSWERS=true
# Optional overrides (defaults: gemini-flash-lite-latest / gemini-embedding-001 @ 768 dims,
# or gpt-4o-mini / text-embedding-3-small @ 1536 dims)
# CHAT_MODEL=
# GEMINI_THINKING_LEVEL=low   # minimal | low | medium | high (higher = slower)
# EMBEDDING_MODEL=
# EMBEDDING_DIMENSIONS=

# Optional: enables the web-search route (https://tavily.com)
TAVILY_API_KEY=
