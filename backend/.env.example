# Copy to .env for local development. Never commit real values.
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173
# CORS_ORIGIN_REGEX=https://merag-.*\.vercel\.app

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# Local: docker compose up mongo   |   Prod: MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=merag

OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Optional: enables the web-search route (https://tavily.com)
TAVILY_API_KEY=
